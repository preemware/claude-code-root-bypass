[Unit]
Description=Watch Claude Code binary dirs; re-apply root-bypass wrapper when the app/CLI updates

[Path]
# Fires when either binary dir changes (new version dropped by a desktop or CLI update)
PathChanged=/root/.claude/remote/ccd-cli
PathChanged=/root/.local/share/claude/versions
Unit=claude-ccd-bypass.service

[Install]
WantedBy=multi-user.target
